{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contextual human alignment record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "profile_id",
    "updated_at",
    "context",
    "owner_reviewed",
    "components",
    "boundaries",
    "permission_preferences"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "record_kind": {
      "enum": [
        "synthetic",
        "owner_published"
      ]
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "owner_reviewed": {
      "type": "boolean"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "permission_preferences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/permission"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "owner_published"
          }
        },
        "required": [
          "record_kind"
        ]
      },
      "then": {
        "properties": {
          "owner_reviewed": {
            "const": true
          },
          "components": {
            "items": {
              "properties": {
                "basis": {
                  "enum": [
                    "self_declared",
                    "owner_approved_interpretation"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis_id",
        "low",
        "high",
        "value",
        "basis",
        "source"
      ],
      "properties": {
        "axis_id": {
          "type": "string",
          "minLength": 1
        },
        "low": {
          "type": "string",
          "minLength": 1
        },
        "high": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1,
          "maximum": 1
        },
        "basis": {
          "enum": [
            "self_declared",
            "owner_approved_interpretation",
            "illustrative"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "preference"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "preference": {
          "enum": [
            "allow",
            "ask",
            "deny"
          ]
        }
      }
    }
  }
}
